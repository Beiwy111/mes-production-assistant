# Reference only: Spring Boot does NOT load this file automatically.
# Keep disabled until Dify is deployed and its Workflow is published.
ASSISTANT_V2_ENABLED=false
# Stage 3 read-only delivery tools; keep off until MES permissions/E2E are accepted.
ASSISTANT_V2_TOOLS_DELIVERY_ENABLED=false
# Stage 4 independent maintenance exporter; no real MES export enabled yet.
ASSISTANT_V2_GRAPH_EXPORT_ENABLED=false
ASSISTANT_V2_GRAPH_EXPORT_BEARER_KEY=
ASSISTANT_V2_GRAPH_EXPORT_ALLOWED_ORDER_IDS=
ASSISTANT_V2_ASSETS_ROOT=
ASSISTANT_V2_DIFY_BASE_URL=
ASSISTANT_V2_DIFY_API_KEY=
ASSISTANT_V2_DIFY_CONNECT_TIMEOUT=5s
ASSISTANT_V2_DIFY_READ_TIMEOUT=120s
ASSISTANT_V2_KNOWLEDGE_ENABLED=false
ASSISTANT_V2_KNOWLEDGE_BASE_URL=
ASSISTANT_V2_KNOWLEDGE_API_KEY=
ASSISTANT_V2_KNOWLEDGE_CONNECT_TIMEOUT=5s
ASSISTANT_V2_KNOWLEDGE_READ_TIMEOUT=120s
ASSISTANT_V2_RUN_TIMEOUT=10m
ASSISTANT_V2_RETENTION=24h
