# Copy to .env.ragflow.local. Create a PRIVATE dataset and API key in the isolated RAGFlow UI.
MES_RAGFLOW_BASE_URL=http://127.0.0.1:19380
MES_RAGFLOW_DATASET_ID=
MES_RAGFLOW_API_KEY=
# Remote deployments require HTTPS, explicit port and an explicit allowlist:
# MES_RAGFLOW_BASE_URL=https://ragflow.example.org:443
# MES_RAGFLOW_ALLOWED_HOSTS=["ragflow.example.org"]
MES_RAGFLOW_PAGE_SIZE=100
MES_RAGFLOW_MAX_PAGES=100
MES_RAGFLOW_MAX_CHUNKS=10000
MES_RAGFLOW_MAX_WAIT_SECONDS=1800
