      "document_version": "1014dab6439cbdf7dbf6d295273d13f30268b8c45d106378c240874fc7b75216",
      "page": 16,
      "quote": "The optimal segmentation proportions and associated gamma values are obtained through the APSO algorithm.",
      "statement": "研究使用APSO求取分段比例和伽马参数。",
      "review_status": "SOURCE_VERIFIED",
      "authority_type": "PUBLIC_RESEARCH"
    },
    {
      "id": "CL_MURA_CNN",
      "subject": "METHOD_CNN",
